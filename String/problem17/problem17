
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int m1 = sc.nextInt();
        int m2 = sc.nextInt();
        int m3 = sc.nextInt();
        int total = m1 + m2 + m3;
        int count = 0;
        if (m1 < 40) count++;
        if (m2 < 40) count++;
        if (m3 < 40) count++;
        if (count == 0) {
            System.out.print("PASS");
        } 
        else if (count == 1 && m1 >= 35 && m2 >= 35 && m3 >= 35 && total >= 150) {
            System.out.print("GRACE PASS");
        } 
        else if (count == 1 && total >= 150 &&
                ((m1 >= 35 && m1 < 40) ||
                 (m2 >= 35 && m2 < 40) ||
                 (m3 >= 35 && m3 < 40))) {
            System.out.print("GRACE PASS");
        } 
        else {
            System.out.print("FAIL");
        }
        sc.close();
    }
}
